# ──────────────────────────────────────────────────────────────────
# St. Augustine TimeQuest — Frontend Environment Variables
# Copy to .env.local — Next.js loads this automatically in dev.
# NEVER commit .env.local to git.
# NEXT_PUBLIC_* variables are exposed to the browser.
# ──────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Map ───────────────────────────────────────────────────────────
# Get a free key at https://cloud.maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key-here
NEXT_PUBLIC_MAP_CENTER_LNG=-81.3124
NEXT_PUBLIC_MAP_CENTER_LAT=29.8951
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=15

# ── Media ─────────────────────────────────────────────────────────
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/timequest-media

# ── Feature flags ─────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=true
NEXT_PUBLIC_ENABLE_AI_HISTORIAN=true
NEXT_PUBLIC_ENABLE_TEAM_PLAY=true

# ── PWA ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=St. Augustine TimeQuest
NEXT_PUBLIC_APP_SHORT_NAME=TimeQuest

# ── Analytics (optional) ──────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-key-here
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
