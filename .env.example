# ──────────────────────────────────────────────────────────────────
# St. Augustine TimeQuest — Backend Environment Variables
# Copy to .env and fill in real values before running.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://timequest:timequest_dev@localhost:5432/timequest
DATABASE_URL_SYNC=postgresql://timequest:timequest_dev@localhost:5432/timequest

# ── Auth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-before-production-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Qdrant (vector search) ────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=st_augustine_sources

# ── MinIO (object storage) ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=timequest
MINIO_SECRET_KEY=timequest_dev_secret
MINIO_BUCKET=timequest-media
MINIO_SECURE=false

# ── Ollama (local LLM) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# ── CORS ──────────────────────────────────────────────────────────
# Must be valid JSON syntax (pydantic-settings parses List[str] env vars as
# JSON) — a bare comma-separated string will crash the app on startup.
CORS_ORIGINS=["http://localhost:3000"]

# ── Game config ───────────────────────────────────────────────────
DEFAULT_GPS_RADIUS_METERS=30
HINT_POINT_PENALTY=5
RAG_UNCERTAINTY_THRESHOLD=0.65

# ── Debug / Testing ───────────────────────────────────────────────
ALLOW_SIMULATED_GPS=true
DEBUG=true

# ── Email (optional — logs to console if not set) ─────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# EMAILS_FROM=noreply@yourdomain.com

# ── Storage ───────────────────────────────────────────────────────
MAX_PHOTO_UPLOAD_MB=15
MAX_DOCUMENT_UPLOAD_MB=50
